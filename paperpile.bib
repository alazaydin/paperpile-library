@ARTICLE{Berke2021-xr,
  title    = "Thinking about thinking through inverse reasoning",
  author   = "Berke, Marlene and Jara-Ettinger, Julian",
  journal  = "PsyArXiv",
  abstract = "Human Theory of Mind enables us to attribute mental states like
