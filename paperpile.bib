@ARTICLE{Qiu2023-iz,
  title     = "Pathways link environmental and genetic factors with structural
               brain networks and psychopathology in youth",
  author    = "Qiu, Anqi and Liu, Chaoqiang",
  journal   = "Neuropsychopharmacology",
  publisher = "Springer Science and Business Media LLC",
  volume    =  48,
  number    =  7,
  pages     = "1042--1051",
  abstract  = "Adolescence is a period of significant brain development and
               maturation, and it is a time when many mental health problems
               first emerge. This study aimed to explore a comprehensive map
               that describes possible pathways from genetic and environmental
               risks to structural brain organization and psychopathology in
