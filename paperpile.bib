@ARTICLE{Degen2013-zf,
  title    = "Cost-based pragmatic inference about referential expressions",
  author   = "Degen, Judith and Franke, M and Jäger, Gerhard",
  journal  = "CogSci",
  volume   =  35,
  abstract = "We present data from three experiments addressing how much theory
              of mind reasoning is involved in production and interpretation of
              ambiguous referential expressions in an artificial language task,
              and how this interacts with the cost and availability of
              alternative utterances. When an unambiguous alternative is not
