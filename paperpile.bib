@ARTICLE{Contemori2025-xo,
  title     = "Metacontrast masking of symmetric stimuli",
  author    = "Contemori, Giulio and Musa, Marianna and Oletto, Carolina Maria
               and Vicentin, Stefano and Battaglini, Luca and Cona, Giorgia and
