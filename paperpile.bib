@ARTICLE{Schilbach2013-nk,
  title     = "Toward a second-person neuroscience",
  author    = "Schilbach, Leonhard and Timmermans, Bert and Reddy, Vasudevi and
               Costall, Alan and Bente, Gary and Schlicht, Tobias and Vogeley,
