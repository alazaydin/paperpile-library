@ARTICLE{Sanchez2026-zz,
  title     = "An open-source closed-loop Virtual Reality system to investigate
               social interactions and collective behavior in fish",
  author    = "Sanchez, Stéphane and Escobedo, Ramón and Bastien, Renaud and
