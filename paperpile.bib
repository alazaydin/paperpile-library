@ARTICLE{Pinho2021-cs,
  title       = "Social and asocial learning in zebrafish are encoded by a
                 shared brain network that is differentially modulated by local
                 activation",
  author      = "Pinho, Júlia and Cunliffe, Vincent and Petri, Giovanni and
                 Oliveira, Rui F",
  journal     = "bioRxiv",
  institution = "bioRxiv",
  pages       = "2021.10.12.464038",
  abstract    = "Abstract Group living animals can use social and asocial cues
                 to predict the presence of a reward or a punishment in the
                 environment through associative learning. The degree to which
                 social and asocial learning share the same mechanisms is still
                 a matter of debate, and, so far, studies investigating the
                 neuronal basis of these two types of learning are scarce and
