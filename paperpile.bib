@ARTICLE{Spengler2009-ew,
  title     = "Control of shared representations relies on key processes
               involved in mental state attribution",
  author    = "Spengler, Stephanie and von Cramon, D Yves and Brass, Marcel",
  journal   = "Hum. Brain Mapp.",
