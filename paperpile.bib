  language  = "en"
}

@ARTICLE{Chung2018-gj,
  title     = "Classification and Geometry of General Perceptual Manifolds",
  author    = "Chung, Sueyeon and Lee, Daniel D and Sompolinsky, Haim",
  journal   = "Phys. Rev. X",
