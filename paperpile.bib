               social status have rapid and profound effects over very short
               time scales and radically alter overt behavior, as well as
               physiological, cellular, and molecular factors that regulate
               reproductive capacity.",
  month     =  oct,
  year      =  2012,
  language  = "en"
}

@ARTICLE{Maruska2013-dn,
  title     = "Social descent with territory loss causes rapid behavioral,
               endocrine and transcriptional changes in the brain",
  author    = "Maruska, Karen P and Becker, Lisa and Neboori, Anoop and Fernald,
               Russell D",
  journal   = "J. Exp. Biol.",
  publisher = "The Company of Biologists",
  volume    =  216,
  number    = "Pt 19",
  pages     = "3656--3666",
  abstract  = "In social species that form hierarchies where only dominant males
               reproduce, lower-ranking individuals may challenge higher-ranking
               ones, often resulting in changes in relative social status. How
               does a losing animal respond to loss of status? Here, using the
               African cichlid fish Astatotilapia burtoni, we manipulated the
