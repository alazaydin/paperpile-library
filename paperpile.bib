  language  = "en"
}

@ARTICLE{Cross2012-iw,
  title     = "Robotic movement preferentially engages the action observation
               network: Robotic Movement Preferentially Engages the {AON}",
  author    = "Cross, Emily S and Liepelt, Roman and Hamilton, Antonia F de C
               and Parkinson, Jim and Ramsey, Richard and Stadler, Waltraud and
