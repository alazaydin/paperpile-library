@ARTICLE{Abril-de-Abreu2015-xl,
  title     = "Social eavesdropping in zebrafish: Tuning of attention to social
               interactions",
  author    = "Abril-de-Abreu, Rodrigo and Cruz, José and Oliveira, Rui F",
