  month     =  mar,
  year      =  2008,
  language  = "en"
}

@ARTICLE{Grezes2004-cy,
  title     = "Inferring false beliefs from the actions of oneself and others:
               an {fMRI} study",
  author    = "Grèzes, J and Frith, C D and Passingham, R E",
  journal   = "Neuroimage",
  publisher = "Elsevier BV",
  volume    =  21,
  number    =  2,
  pages     = "744--750",
  abstract  = "The ability to make judgments about mental states is critical to
               social interactions. Simulation theory suggests that the observer
               covertly mimics the activity of the observed person, leading to
               shared states of mind between the observer and the person
               observed. We tested this hypothesis by investigating the neural
               networks activated while subjects watched videos of themselves
