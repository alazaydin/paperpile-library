}

@ARTICLE{Fan2010-lb,
  title     = "Unbroken mirror neurons in autism spectrum disorders: Unbroken
               mirror neurons in {ASD}",
  author    = "Fan, Yang-Teng and Decety, Jean and Yang, Chia-Yen and Liu,
